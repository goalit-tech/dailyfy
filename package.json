{
  "name": "dailyfy",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/generator-fiori": "^1.33.0",
    "yo": "^7.0.1"
  },
  "scripts": {
    "start": "cds-serve",
    "createuiapp": "node _script/ui/create-ui-app.js"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "model": "db",
        "credentials": {
          "url": "dailyfy.db"
        }
      }
    }
  }
}
