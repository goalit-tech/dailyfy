{
  "name": "dailyfy",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/postgres": "^3",
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/generator-fiori": "^1.33.0",
    "yo": "^7.0.1"
  },
  "scripts": {
    "start": "cds-serve",
    "watch:pg": "cds watch --profile postgres",
    "start:pg": "cds-serve --profile postgres",
    "deploy:pg": "cds deploy --profile postgres",
    "createuiapp": "node _script/ui/create-ui-app.js"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "model": "db",
        "credentials": {
          "url": "dailyfy.db"
        }
      }
    },
    "[postgres]": {
      "requires": {
        "db": {
          "kind": "postgres",
          "impl": "@cap-js/postgres",
          "model": "db",
          "pool": {
            "acquireTimeoutMillis": 30000
          },
          "credentials": {
            "port": 5432,
            "ssl": {
              "rejectUnauthorized": false
            }
          }
        }
      }
    }
  }
}
