<mvc:View controllerName="__NAMESPACE__.controller.List"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	displayBlock="true">
	<Page id="page"
		showHeader="false"
		enableScrolling="true"
		class="sapUiContentPadding __CSS_CLASS__">
		<Table id="table"
			inset="false"
			items="{/items}">
			<headerToolbar>
				<OverflowToolbar>
					<Title text="{i18n>listViewTitle}"
						level="H2" />
					<ToolbarSpacer />
				</OverflowToolbar>
			</headerToolbar>
			<columns>
				<Column width="8em">
					<Text text="ID" />
				</Column>
				<Column>
					<Text text="Name" />
				</Column>
				<Column>
					<Text text="Category" />
				</Column>
			</columns>
			<items>
				<ColumnListItem type="Navigation"
					press=".onPressListItem">
					<cells>
						<Text text="{id}" />
						<Text text="{name}" />
						<Text text="{category}" />
					</cells>
				</ColumnListItem>
			</items>
		</Table>
	</Page>
</mvc:View>
