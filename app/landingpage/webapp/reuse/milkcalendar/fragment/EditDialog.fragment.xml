<core:FragmentDefinition
		xmlns="sap.m"
        xmlns:l="sap.ui.layout"
	    xmlns:f="sap.ui.layout.form"
		xmlns:core="sap.ui.core">
	<Dialog id="idDialogEdit"
		title="{i18n>editDialogTitle}"
        contentWidth="100%"
        contentHeight="100%"
        stretch="true"
		>
        <VBox id="idVBoxEditForm" class="sapUiSmallMargin">
		<f:SimpleForm id="idSimpleFormEdit"
			editable="true"
			layout="ResponsiveGridLayout"
			labelSpanXL="3"
			labelSpanL="3"
			labelSpanM="3"
			labelSpanS="12"
			adjustLabelSpan="false"
			emptySpanXL="4"
			emptySpanL="4"
			emptySpanM="4"
			emptySpanS="0"
			columnsXL="1"
			columnsL="1"
			columnsM="1"
			singleContainerFullSize="false" >
			<f:content>
				<Label id="idLabelProductName" text="{i18n>productName}" />
				<Input id="idInputProductName" value="{name}" />
				<Label id="idLabelProductDescription" text="{i18n>productDescription}" />
				<Input id="idInputProductDescription" value="{description}"/>
				<Label id="idLabelVendorName" text="{i18n>vendorName}" />
				<Input id="idInputVendorName" value="{local>/vendorName}" />
				<Label id="idLabelVendorEmail" text="{i18n>vendorEmail}" />
				<Input id="idInputVendorEmail" value="{local>/vendorEmail}" type="Email"/>
				<Label id="idLabelVendorAddress" text="{i18n>vendorAddress}" />
				<TextArea id="idTextAreaVendorAddress" value="{local>/vendorAddress}" rows="3" />
				<Label id="idLabelVendorMobileNo" text="{i18n>vendorMobileNo}" />
				<Input id="idInputVendorMobileNo" value="{local>/vendorMobileNo}" type="Tel" maxLength="15" />
				<Label id="idLabelRate" text="{i18n>rate}" />
				<Input id="idInputUnitRate" value="{unitPrice_amount}">
					<layoutData>
						<l:GridData id="idGridDataUnitRate" span="XL4 L3 M3 S8" />
					</layoutData>
				</Input>
				<Input id="idInputCurrency" value="{unitPrice_currency}">
					<layoutData>
						<l:GridData id="idGridDataCurrency" span="XL1 L2 M2 S4" />
					</layoutData>
				</Input>
				<Label id="idLabelBaseQuantity" text="{i18n>baseQuantity}" />
				<StepInput id="idStepInputBaseQuantity" value="{path: 'defaultQuantity_quantity', type: 'sap.ui.model.type.Float', formatOptions: {decimals: 2}}"
					min="0" max="5" step="1" displayValuePrecision="2">
					<layoutData>
						<l:GridData id="idGridDataBaseQuantity" span="XL4 L3 M3 S8" />
					</layoutData>
				</StepInput>
				<Input id="idInputUom" value="{defaultQuantity_uom}">
					<layoutData>
						<l:GridData id="idGridDataUom" span="XL1 L2 M2 S4" />
					</layoutData>
				</Input>
			</f:content>
		</f:SimpleForm>
	</VBox>
    <buttons>
        <Button id="idButtonCancel" text="{i18n>cancel}" press=".onCancelEditDialogPress"/>
        <Button id="idButtonUpdate" text="{i18n>update}" press=".onUpdateEditDialogPress"/>
    </buttons>
	</Dialog>
</core:FragmentDefinition>