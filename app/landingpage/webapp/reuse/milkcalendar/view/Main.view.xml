<mvc:View controllerName="goalittech.ui.reuse.milkcalendar.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
     xmlns:f="sap.f"
    xmlns:unified="sap.ui.unified"
    xmlns="sap.m">
    <Page id="idMilkcalendarMainPage">
    	<customHeader>
			<Toolbar>
				<Title text="Milkman Name" level="H2"/>
				<ToolbarSpacer/>
				<ToolbarSpacer/>
				<Button icon="sap-icon://edit" type="Transparent" press=".onEditPress" ariaLabelledBy="editButtonLabel"/>
				<ToggleButton icon="sap-icon://select-appointments" pressed="{local>/toggleIntervalSelection}" type="{=${local>/toggleIntervalSelection ? 'Emphasized' : 'Transparent'}}" press=".onCalendarTogglePress"/>
			</Toolbar>

		</customHeader>
        <VBox id="editSection" width="100%" height="100%">
        <HBox width="100%" justifyContent="SpaceBetween" alignItems="Start" class="sapUiSmallMargin">
            <VBox alignItems="Start">
                <ObjectStatus id="_IDGenObjectStatusRate" title="Rate" text="50 ₹/Liter"  />
            </VBox>
            <VBox alignItems="End" class="sapUiMediumMarginEnd">
             <ObjectStatus id="_IDGenObjectStatusBaseQty" title="Base Qty" text="{cal>/baseQty} Liter"  />
            </VBox>
        </HBox>
        <FormattedText id="totalAmountText" class="sapUiSmallMarginBeginEnd sapUiTinyMarginBottom"
            htmlText="{parts: [{path: 'summary>/currency'}, {path: 'summary>/totalAmount'}, {path: 'summary>/liters'}, {path: 'summary>/days'}], formatter: '.formatTotalSummary'}" />
        <FlexBox id="calendarBox" width="100%" fitContainer="true">
        
        <VBox id="calendarSection" width="100%" height="100%" >
            <unified:Calendar id="dailyLogsCalendar" width="100%" class="smartDailyCalendar" 
                select=".handleCalendarSelect"
                intervalSelection="{local>/toggleIntervalSelection}"
                specialDates="{path: 'cal>/days', templateShareable: false}">
                <unified:specialDates>
                    <unified:DateTypeRange id="dailyLogDate"
                        startDate="{path: 'cal>logDate', formatter: '.formatCalendarDate'}"
                        type="{parts: [{path: 'cal>quantity'}, {path: 'cal>/baseQty'}], formatter: '.formatCalendarType'}"
                        tooltip="{cal>remarks}" />
                </unified:specialDates>
            </unified:Calendar>
        </VBox>
        </FlexBox>
        <List id="monthlySummaryList" visible="{local>/toggleIntervalSelection}" items="{monthly>/months}"
            headerText="Monthly Milk Consumption" class="sapUiSmallMarginTop" noDataText="No monthly data">
            <CustomListItem>
                <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMargin">
                    <VBox>
                        <Title text="{monthly>month}" level="H4"/>
                        <Text text="Amount: {summary>/currency}{monthly>amount}  |  {monthly>liters} L  |  {monthly>days} Days"/>
                    </VBox>
                    <ObjectStatus text="{= ${monthly>paid} ? 'Paid' : 'Not Paid'}"
                        state="{= ${monthly>paid} ? 'Success' : 'Error'}"
                        icon="{= ${monthly>paid} ? 'sap-icon://sys-enter-2' : 'sap-icon://error'}"
                        inverted="false"/>
                </HBox>
            </CustomListItem>
        </List>
        <HBox class="sapUiTinyMargin" visible="{= ${local>/showQuantity} &amp;&amp; !${local>/toggleIntervalSelection}}">
			<Label text="Quantity:" labelFor="SI" class="sapUiTinyMarginTop sapUiTinyMarginEnd"/>
			<StepInput id="SI" width="12rem"
                value="{cal>quantity}"
                min="0" max="5" step="1" displayValuePrecision="2"
                valueState="{parts: [{path: 'cal>quantity'}, {path: 'cal>/baseQty'}], formatter: '.formatQuantityState'}"/>
		</HBox>
        </VBox>
    </Page>
</mvc:View>