<mvc:View controllerName="goalittech.ui.reuse.milkcalendar.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
     xmlns:f="sap.f"
    xmlns:unified="sap.ui.unified"
    xmlns:custom="goalittech.ui.reuse.milkcalendar.control"
    xmlns="sap.m">
    <Page id="idPageMilkcalendarMain">
    	<customHeader>
			<Toolbar id="idToolbarHeader">
				<Title id="idTitleMilkmanName" text="{i18n>milkmanName}" level="H2"/>
				<ToolbarSpacer id="idToolbarSpacerStart"/>
				<ToolbarSpacer id="idToolbarSpacerEnd"/>
				<Button id="idButtonEdit" icon="sap-icon://edit" type="Transparent" press=".onEditPress" ariaLabelledBy="editButtonLabel"/>
				<ToggleButton id="idToggleButtonSelectAppointments" icon="sap-icon://select-appointments" pressed="{local>/toggleIntervalSelection}" type="{=${local>/toggleIntervalSelection ? 'Emphasized' : 'Transparent'}}" press=".onCalendarTogglePress"/>
			</Toolbar>

		</customHeader>
        <VBox id="idVBoxEditSection" width="100%" height="100%">
        <HBox id="idHBoxSummary" width="100%" justifyContent="SpaceBetween" alignItems="Start" class="sapUiSmallMargin">
            <VBox id="idVBoxRate" alignItems="Start">
                <ObjectStatus id="idObjectStatusRate" title="{i18n>rate}" text="{= Number(${unitPrice_amount} || 0) + ' ' + (${unitPrice_currency} || '') + '/' + ${i18n>liter}}"  />
            </VBox>
            <VBox id="idVBoxBaseQty" alignItems="End" class="sapUiMediumMarginEnd">
             <ObjectStatus id="idObjectStatusBaseQty" title="{i18n>baseQty}" text="{= Number(${defaultQuantity_quantity} || 0) + ' ' + ${i18n>liter}}"  />
            </VBox>
        </HBox>
        <FormattedText id="idFormattedTextTotalAmount" class="sapUiSmallMarginBeginEnd sapUiTinyMarginBottom"
            htmlText="{parts: [{path: 'currency'}, {path: 'amount'}, {path: 'liters'}, {path: 'days'}, {path: 'i18n>totalSummary'}, {path: 'i18n>totalSummaryLiters'}, {path: 'i18n>totalSummaryDays'}], formatter: '.formatTotalSummary'}" />
        <FlexBox id="idFlexBoxCalendar" width="100%" fitContainer="true">
        
        <VBox id="idVBoxCalendar" width="100%" height="100%" >
            <unified:Calendar id="idUnifiedCalendar" width="100%" class="smartDailyCalendar" 
                select=".handleCalendarSelect"
                startDateChange=".onCalendarStartDateChange"
                intervalSelection="{local>/toggleIntervalSelection}"
                specialDates="{path: '/DailyLogs', suspended: true, parameters: {$$updateGroupId: '$auto'}, templateShareable: false}">
                <unified:specialDates>
                    <unified:DateTypeRange id="idUnifiedDateTypeRange"
                        startDate="{logDate}"
                        type="{parts: [{path: 'quantity_quantity'}, {path: 'product/defaultQuantity_quantity'}], formatter: '.formatCalendarType'}"
                        tooltip="{remarks}" />
                </unified:specialDates>
            </unified:Calendar>
        </VBox>
        </FlexBox>
        <List id="idListMonthlySummary" visible="{local>/toggleIntervalSelection}"
            items="{path: '/MonthlySummary', sorter: [{path: 'year', descending: true}, {path: 'month', descending: true}]}"
            headerText="{i18n>monthlySummaryHeader}" class="sapUiSmallMarginTop" noDataText="{i18n>monthlySummaryNoData}">
            <CustomListItem id="idCustomListItemMonthly">
                <HBox id="idHBoxMonthly" justifyContent="SpaceBetween" alignItems="Center" class="sapUiSmallMargin">
                    <VBox id="idVBoxMonthlyDetails">
                        <Title id="idTitleMonth" text="{parts: [{path: 'year'}, {path: 'month'}], formatter: '.formatMonth'}" level="H4"/>
                        <Text id="idTextMonthlyAmount" text="{parts: [{path: 'i18n>monthlySummaryDetails'}, {path: 'currency'}, {path: 'amount'}, {path: 'liters'}, {path: 'days'}], formatter: '.formatMonthlySummary'}"/>
                    </VBox>
                </HBox>
            </CustomListItem>
        </List>
        <HBox id="idHBoxQuantity" class="sapUiTinyMargin" visible="{= ${local>/showQuantity} &amp;&amp; !${local>/toggleIntervalSelection}}">
			<Label id="idLabelQuantity" text="{i18n>quantity}" labelFor="idStepInputQuantity" class="sapUiTinyMarginTop sapUiTinyMarginEnd"/>
			<custom:QuantityStepInput id="idStepInputQuantity" width="12rem"
                value="{path: 'quantity_quantity', type: 'sap.ui.model.type.Float', formatOptions: {maxFractionDigits: 2}}"
                min="0" max="5" step="1" displayValuePrecision="2"
                valueState="{parts: [{path: 'quantity_quantity'}, {path: 'product/defaultQuantity_quantity'}], formatter: '.formatQuantityState'}"/>
		</HBox>
        </VBox>
    </Page>
</mvc:View>