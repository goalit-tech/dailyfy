<mvc:View controllerName="goalittech.ui.reuse.milkcalendar.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
     xmlns:f="sap.f"
    xmlns:unified="sap.ui.unified"
    xmlns="sap.m">
    <Page id="idMilkcalendarMainPage">
    <!-- xmlns:macros="sap.fe.macros" -->
    	<customHeader>
			<Toolbar>
				<Title text="Milkman Name" level="H2"/>
				<ToolbarSpacer/>
				<ToolbarSpacer/>
				<Button icon="sap-icon://edit" type="Transparent" press=".onPress" ariaLabelledBy="editButtonLabel"/>
				<Button icon="sap-icon://select-appointments" type="Transparent" press=".onPress" ariaLabelledBy="editButtonLabel"/>
			</Toolbar>

		</customHeader>
        <VBox id="editSection" width="100%" height="100%">
        <HBox width="100%" justifyContent="SpaceBetween" alignItems="Start" class="sapUiSmallMargin">
            <VBox alignItems="Start">
                <ObjectStatus id="_IDGenObjectStatusRate" title="Rate" text="50 ₹/Liter"  />
            </VBox>
            <VBox alignItems="End" class="sapUiMediumMarginEnd">
             <ObjectStatus id="_IDGenObjectStatusBaseQty" title="Base Qty" text="{cal>/baseQty} Liter"  />
            </VBox>
        </HBox>
        <FormattedText id="totalAmountText" class="sapUiSmallMarginBeginEnd sapUiTinyMarginBottom"
            htmlText="{parts: [{path: 'summary>/currency'}, {path: 'summary>/totalAmount'}, {path: 'summary>/liters'}, {path: 'summary>/days'}], formatter: '.formatTotalSummary'}" />
        <FlexBox id="calendarBox" width="100%" fitContainer="true">
        
        <VBox id="calendarSection" width="100%" height="100%" >
            <unified:Calendar id="dailyLogsCalendar" width="100%" class="smartDailyCalendar" select=".onDateSelect"
                singleSelection="true"
                intervalSelection="true"
                specialDates="{path: 'cal>/days', templateShareable: false}">
                <unified:specialDates>
                    <unified:DateTypeRange id="dailyLogDate"
                        startDate="{path: 'cal>logDate', formatter: '.formatCalendarDate'}"
                        type="{parts: [{path: 'cal>quantity'}, {path: 'cal>/baseQty'}], formatter: '.formatCalendarType'}"
                        tooltip="{cal>remarks}" />
                </unified:specialDates>
            </unified:Calendar>
        </VBox>
        </FlexBox>
        <HBox class="sapUiTinyMargin">
			<Label text="Quantity:" labelFor="SI" class="sapUiTinyMarginTop sapUiTinyMarginEnd"/>
			<StepInput id="SI" min="0" max="4" width="12rem"
                value="{cal>quantity}"
                valueState="{parts: [{path: 'cal>quantity'}, {path: 'cal>/baseQty'}], formatter: '.formatQuantityState'}"/>
		</HBox>
        </VBox>
    </Page>
</mvc:View>