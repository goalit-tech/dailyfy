{
	"_version": "1.90.0",
	"sap.app": {
		"id": "goalittech.ui.reuse.sample",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [
				""
			],
			"fallbackLocale": ""
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "1.0.0"
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"contentDensities": {
			"cozy": true,
			"compact": true
		},
		"rootView": {
			"viewName": "goalittech.ui.reuse.sample.view.App",
			"type": "XML",
			"id": "app"
		},
		"dependencies": {
			"minUI5Version": "1.153.0",
			"libs": {
				"sap.m": {},
				"sap.ui.core": {},
				"sap.ui.layout": {}
			}
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "goalittech.ui.reuse.sample.i18n.i18n",
					"supportedLocales": [
						""
					],
					"fallbackLocale": ""
				}
			},
			"": {
				"type": "sap.ui.model.json.JSONModel",
				"uri": "model/items.json"
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				}
			]
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"viewType": "XML",
				"path": "goalittech.ui.reuse.sample.view",
				"controlId": "app",
				"controlAggregation": "pages",
				"transition": "slide",
				"bypassed": {
					"target": "notFound"
				}
			},
			"routes": [
				{
					"name": "list",
					"pattern": "",
					"target": "list"
				},
				{
					"name": "detail",
					"pattern": "detail/{id}",
					"target": "detail"
				}
			],
			"targets": {
				"list": {
					"type": "View",
					"id": "list",
					"name": "List",
					"title": "Sample List"
				},
				"detail": {
					"type": "View",
					"id": "detail",
					"name": "Detail",
					"title": "Sample Detail"
				},
				"notFound": {
					"type": "View",
					"id": "notFound",
					"name": "NotFound",
					"transition": "show"
				}
			}
		}
	}
}
